PORT=4000
NODE_ENV=development
# Origem(ns) permitida(s) para CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# --- Fase 5: Auth & Persistência ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/harmonia
JWT_SECRET=troque-isso-em-producao-para-algo-aleatorio-e-longo
JWT_EXPIRES_IN=7d
STORAGE_DIR=/app/storage

# Login com Google — opcional. Sem essas duas variáveis, /api/auth/google
# responde 501 em vez de quebrar. Para configurar de verdade:
# 1. https://console.cloud.google.com/apis/credentials
# 2. Criar credencial "OAuth client ID", tipo "Web application"
# 3. Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
